<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-kan-12-pinned-products" author="codex">
        <createTable tableName="pinned_products">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_pinned_products" nullable="false"/>
            </column>
            <column name="scope_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="scope_id" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="product_key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="default_quantity" type="NUMERIC(10,2)"/>
            <column name="unit" type="VARCHAR(64)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="pinned_products"
                columnNames="scope_type, scope_id, product_key"
                constraintName="uk_pinned_products_scope_key"/>

        <createIndex tableName="pinned_products" indexName="idx_pinned_products_scope">
            <column name="scope_type"/>
            <column name="scope_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
