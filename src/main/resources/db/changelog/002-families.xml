<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-families" author="psk">
        <createTable tableName="families">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="invite_code" type="VARCHAR(6)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="admin_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_families_invite_code" tableName="families">
            <column name="invite_code"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-create-family-members" author="psk">
        <createTable tableName="family_members">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="family_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_family_members_family"
                             references="families(id)"
                             deleteCascade="true"/>
            </column>
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="joined_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="family_members"
                             columnNames="family_id, user_id"
                             constraintName="uq_family_members_family_user"/>

        <createIndex indexName="idx_family_members_user_id" tableName="family_members">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
