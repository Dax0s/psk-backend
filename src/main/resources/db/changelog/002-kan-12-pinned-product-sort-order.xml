<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-kan-12-pinned-product-sort-order" author="codex">
        <addColumn tableName="pinned_products">
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <update tableName="pinned_products">
            <column name="sort_order" valueComputed="id"/>
        </update>

        <createIndex tableName="pinned_products" indexName="idx_pinned_products_scope_sort">
            <column name="scope_type"/>
            <column name="scope_id"/>
            <column name="sort_order"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
