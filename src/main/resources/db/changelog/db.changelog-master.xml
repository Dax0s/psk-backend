<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="domas">
        <createTable tableName="user">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="cognito_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="domas">
        <createTable tableName="shopping_list">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_shopping_list_user"
                             references="user(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="3" author="domas">
        <createTable tableName="shopping_list_item">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="shopping_list_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_shopping_list_item_shopping_list"
                             references="shopping_list(id)"
                             deleteCascade="true"
                />
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="checked" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="4" author="pranas">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="families"/></not>
        </preConditions>
        <createTable tableName="families">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="invite_code" type="VARCHAR(6)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="admin_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_families_invite_code" tableName="families">
            <column name="invite_code"/>
        </createIndex>
    </changeSet>

    <changeSet id="5" author="pranas">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="family_members"/></not>
        </preConditions>
        <createTable tableName="family_members">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="family_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_family_members_family"
                             references="families(id)"
                             deleteCascade="true"/>
            </column>
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="joined_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="family_members"
                             columnNames="family_id, user_id"
                             constraintName="uq_family_members_family_user"/>

        <createIndex indexName="idx_family_members_user_id" tableName="family_members">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="7" author="pranas">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="user" columnName="email"/></not>
        </preConditions>
        <addColumn tableName="user">
            <column name="email" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="8" author="pranas">
        <dropColumn tableName="families" columnName="admin_id"/>
        <addColumn tableName="families">
            <column name="admin_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_families_admin_user" references="user(id)"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="9" author="pranas">
        <dropUniqueConstraint tableName="family_members" constraintName="uq_family_members_family_user"/>
        <dropIndex tableName="family_members" indexName="idx_family_members_user_id"/>
        <dropColumn tableName="family_members" columnName="user_id"/>
        <addColumn tableName="family_members">
            <column name="user_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_family_members_user" references="user(id)"/>
            </column>
        </addColumn>
        <addUniqueConstraint tableName="family_members"
                             columnNames="family_id, user_id"
                             constraintName="uq_family_members_family_user"/>
        <createIndex tableName="family_members" indexName="idx_family_members_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
