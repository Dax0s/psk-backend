<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="domas">
        <createTable tableName="user">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="cognito_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="domas">
        <createTable tableName="shopping_list">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_shopping_list_user"
                             references="user(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="3" author="domas">
        <createTable tableName="shopping_list_item">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="shopping_list_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_shopping_list_item_shopping_list"
                             references="shopping_list(id)"
                             deleteCascade="true"
                />
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="checked" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="4" author="gintaras">
        <createTable tableName="pinned_product">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_pinned_product_user"
                             references="user(id)"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="default_quantity" type="DECIMAL(10,2)"/>
            <column name="sort_order" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="5" author="ainius">
        <createTable tableName="product_offer">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="source" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="DECIMAL(10,2)"/>
            <column name="old_price" type="VARCHAR(64)"/>
            <column name="discount_pct" type="INT"/>
            <column name="unit_price" type="VARCHAR(128)"/>
            <column name="valid_to" type="VARCHAR(32)"/>
            <column name="promo" type="VARCHAR(64)"/>
            <column name="image_url" type="VARCHAR(1024)"/>
            <column name="refreshed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint
                tableName="product_offer"
                columnNames="source, category, name"
                constraintName="uq_product_offer_source_category_name"/>
        <createIndex tableName="product_offer" indexName="idx_product_offer_name">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="6" author="ainius">
        <addColumn tableName="shopping_list_item">
            <column name="category" type="VARCHAR(64)" defaultValue="OTHER">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="7" author="ainius">
        <addColumn tableName="pinned_product">
            <column name="category" type="VARCHAR(64)" defaultValue="OTHER">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="8" author="pranas">
        <createTable tableName="family">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="invite_code" type="VARCHAR(6)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="admin_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_family_admin"
                             references="user(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_family_invite_code" tableName="family">
            <column name="invite_code"/>
        </createIndex>
    </changeSet>

    <changeSet id="9" author="pranas">
        <createTable tableName="family_member">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="family_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_family_member_family"
                             references="family(id)"
                             deleteCascade="true"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_family_member_user"
                             references="user(id)"/>
            </column>
            <column name="joined_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="family_member"
                             columnNames="family_id, user_id"
                             constraintName="uq_family_member_family_user"/>

        <createIndex indexName="idx_family_member_user_id" tableName="family_member">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="10" author="pranas">
        <addColumn tableName="user">
            <column name="email" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="11" author="justinas">
        <addColumn tableName="shopping_list">
            <column name="family_id" type="UUID">
                <constraints nullable="true"
                             foreignKeyName="fk_shopping_list_family"
                             references="family(id)"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="12" author="domas">
        <addColumn tableName="shopping_list_item">
            <column name="version" type="INTEGER"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
